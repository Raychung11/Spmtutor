# Serve uploaded files but never execute them as scripts.
php_flag engine off
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
  AddType text/plain .php .phtml .pl .py
</IfModule>
<FilesMatch "\.(?i:php|phtml|php[3-8]|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
